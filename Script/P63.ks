function executeRoverInsertion {
    //PID loop to hover above a certain "safe" altitude to deploy the rover.
    //Should be simple stage instructions to detach rover. Might want to think about safety checks in the future to make sure it is actually a viable landing location.
    stage.
    wait 1.
    lock throttle to 0.5.
    wait 3.
    lock throttle to 0.

}
main().